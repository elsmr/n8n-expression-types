{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
	"files": { "ignore": ["**/package.json", "packages/@n8n/expression-types/src/extensions.d.ts"] },
	"formatter": { "indentStyle": "tab", "indentWidth": 2, "lineEnding": "lf", "lineWidth": 100 },
	"organizeImports": { "enabled": false },
	"linter": { "enabled": false },
	"overrides": [
		{ "include": ["**/tsconfig*.json"], "json": { "parser": { "allowComments": true } } }
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always"
		}
	}
}
