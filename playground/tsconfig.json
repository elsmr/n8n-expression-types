{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "plugins": [{ "name": "n8n-expression-ts-plugin" }]
  },
  "include": ["*.ts", "../shapes.d.ts", "../extensions.d.ts"]
}
