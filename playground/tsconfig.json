{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "plugins": [{ "name": "@n8n/expression-ts-plugin" }]
  },
  "include": ["*.ts"]
}
