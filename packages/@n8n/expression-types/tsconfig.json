{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/*.ts"]
}
