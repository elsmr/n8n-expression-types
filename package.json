{
  "name": "@n8n/expression-types-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "open": "pnpm build && code --extensionDevelopmentPath=\"$PWD/packages/vscode-n8n-expressions\" --folder-uri \"file://$PWD/playground\" --goto \"$PWD/playground/demo.ts:1\"",
    "dev": "pnpm build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm build && tsx packages/@n8n/expression-ts-plugin/plugin.test.ts && tsx packages/@n8n/expression-ts-plugin/tsserver.test.ts",
    "typecheck": "biome format . && pnpm build && pnpm check && tsc -p packages/@n8n/expression-ts-plugin && tsc -p playground",
    "check": "node packages/@n8n/expression-ts-plugin/dist/cli.mjs check playground/tsconfig.json --expression-errors=warn",
    "gen-extensions": "tsx scripts/gen-extensions.ts",
    "prepare": "pnpm build && pnpm check",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "n8n-workflow": "^2.16.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
