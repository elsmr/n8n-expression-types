{
  "name": "@n8n/expression-types-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plugin": "pnpm --filter @n8n/expression-ts-plugin build",
    "prepare": "pnpm build:plugin",
    "demo": "tsx playground/service-demo.ts",
    "drift": "pnpm --filter @n8n/expression-types drift",
    "gen-extensions": "pnpm --filter @n8n/expression-types gen-extensions",
    "gen-resolved": "tsx packages/core/gen-resolved.ts playground/tsconfig.json",
    "smoke": "pnpm build:plugin && tsx packages/plugin/smoke.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/plugin && pnpm gen-resolved && tsc -p playground"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
