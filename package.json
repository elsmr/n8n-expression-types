{
  "name": "@n8n/expression-types-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "open": "pnpm build:plugin && code --extensionDevelopmentPath=\"$PWD/packages/vscode\" \"$PWD/playground\" \"$PWD/playground/node-description.ts\"",
    "test": "pnpm build:plugin && tsx packages/plugin/plugin.test.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/plugin && tsx packages/core/check.ts playground/tsconfig.json --expression-errors=warn",
    "check": "tsx packages/core/check.ts playground/tsconfig.json",
    "drift": "tsx packages/core/drift.ts",
    "gen-extensions": "tsx packages/core/gen-extensions.ts",
    "vsix": "pnpm build:plugin && node scripts/build-vsix.mjs",
    "build:plugin": "pnpm --filter @n8n/expression-ts-plugin build",
    "prepare": "pnpm build:plugin"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
